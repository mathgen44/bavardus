# Bavardus — modèle de configuration. Copier en .env et remplir.
# NE JAMAIS COMMITER LE .env (garde-fou G5).

# --- Twitch (console développeur Twitch) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Doit correspondre EXACTEMENT à une OAuth Redirect URL déclarée sur Twitch.
# Voie de secours (localhost autorisé en HTTP par Twitch) :
TWITCH_REDIRECT_URI=http://localhost:8475/api/twitch/callback
# Voie publique, une fois Nginx Proxy Manager réparé :
# TWITCH_REDIRECT_URI=https://bavardus.mathgen.fr/api/twitch/callback

TWITCH_CHANNEL=mathgen44
TWITCH_CALLBACK_PORT=8475

# --- Streamlabs ---
# streamlabs.com/dashboard > Paramètres du compte > API Settings > Your Socket API Token
STREAMLABS_SOCKET_TOKEN=

# --- Modèles ---
OLLAMA_URL=http://192.168.0.139:11434
OPENROUTER_API_KEY=
